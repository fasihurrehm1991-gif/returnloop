SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# For hosted PostgreSQL, set DATABASE_URL and leave DB_* values unused.
DATABASE_URL=
DB_ENGINE=sqlite
DB_NAME=lost_found
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ReturnLoop <no-reply@example.com>
